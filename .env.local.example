# Contact form email delivery (Gmail SMTP via Nodemailer).
# Copy this file to ".env.local" and fill in real values.
#
# 1. Use your Gmail address below.
# 2. Enable 2-Step Verification on that Google account.
# 3. Create an "App Password": https://myaccount.google.com/apppasswords
#    (choose "Mail" → "Other") and paste the 16-character code below.
#
# Messages submitted through the contact form are emailed to
# prashant983869@gmail.com (set as TO_ADDRESS in app/api/contact/route.ts).

GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
